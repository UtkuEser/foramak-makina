# ================================================================
# Teklif sistemi — Edge Function ortam değişkenleri (ÖRNEK)
#
# Bu dosyada gerçek değer YOKTUR. Gerçek değerler:
#   - Canlı proje: Supabase Dashboard → Edge Functions → Secrets
#   - Yerel (supabase functions serve): supabase/functions/.env  (git'e girmez)
#
# SUPABASE_URL ve sunucu anahtarı (SUPABASE_SECRET_KEYS /
# SUPABASE_SERVICE_ROLE_KEY) Supabase tarafından otomatik sağlanır; elle
# eklenmez. "SUPABASE_" ile başlayan özel değişken tanımlanamaz.
# ================================================================

# production | development
#   production  → yalnızca https production origin'leri, Turnstile test anahtarı reddedilir
#   development → yalnızca localhost / 127.0.0.1 origin'leri
QUOTE_ENVIRONMENT=development

# Virgülle ayrılmış origin listesi (yol veya / olmadan)
#   production örneği: https://www.foramak.com,https://foramak.com
QUOTE_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# production'da başvuru kabulü. KVKK ve yurt dışı aktarım değerlendirmesi
# tamamlanmadan true yapılmaz. (development'ta dikkate alınmaz)
QUOTE_SUBMISSIONS_ENABLED=false

# Cloudflare Turnstile secret key
#   Yerel test: Cloudflare resmi test anahtarı (her zaman geçer)
#   1x0000000000000000000000000000000AA  → geçer
#   2x0000000000000000000000000000000AA  → her zaman başarısız (hata testi)
#   PRODUCTION'DA TEST ANAHTARI KULLANILMAZ (kod da reddeder)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Hız sınırı için IP özet tuzu — en az 16 karakter rastgele değer
#   Üretmek için: openssl rand -hex 32
QUOTE_IP_HASH_SALT=

# Resend
RESEND_API_KEY=
FORM_NOTIFICATION_EMAIL=foramak@foramaklazer.com
# Resend'de doğrulanmış alan adından gönderici (örnek: notify.foramak.com)
FORM_SENDER_EMAIL=Foramak Teklif Formu <teklif@notify.foramak.com>

# quote-maintenance çağrıları için gizli başlık değeri — en az 32 karakter
#   Üretmek için: openssl rand -hex 32
MAINTENANCE_SECRET=

# İsteğe bağlı: SUPABASE_SECRET_KEYS içinde "default" dışında bir anahtar adı kullanılacaksa
# QUOTE_SECRET_KEY_NAME=default
